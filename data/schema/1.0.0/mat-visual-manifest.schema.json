{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mat-codex.local/schema/1.0.0/mat-visual-manifest.schema.json",
  "title": "MAT visual manifest",
  "description": "V-slot visual registry. Accepts both H-style (filename/path/status) and Li-style (file/files list + status) slots, plus summary-only manifests.",
  "type": "object",
  "properties": {
    "registry_id": { "type": "string" },
    "record_id": { "type": "string", "pattern": "^MAT:(00\\d\\d|010\\d|011[0-8])$" },
    "manifest_version": { "type": "string" },
    "version": { "type": "string" },
    "visuals": {
      "type": "object",
      "patternProperties": {
        "^V\\d+$": {
          "type": "object",
          "properties": {
            "asset_id": { "type": "string" },
            "filename": { "type": "string" },
            "file": { "type": "string" },
            "files": { "type": "array", "items": { "type": "string" } },
            "assets": { "type": "array" },
            "path": { "type": "string" },
            "status": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "summary": { "type": "object" },
    "status": { "type": ["object", "string"] }
  },
  "additionalProperties": true
}
