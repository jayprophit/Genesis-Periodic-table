{
  "name": "mat-codex",
  "version": "1.0.0",
  "private": true,
  "description": "Materials Atlas Table Codex — validation toolchain and book build.",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-mat.mjs",
    "validate:records": "node scripts/validate-records.mjs",
    "validate:sources": "node scripts/validate-sources.mjs",
    "validate:relationships": "node scripts/validate-relationships.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "validate:links": "node scripts/check-links.mjs",
    "validate:ids": "node scripts/check-identifiers.mjs",
    "validate:booksync": "node scripts/check-book-sync.mjs",
    "validate:elements": "node scripts/validate-elements.mjs",
    "build:book": "node book/build/book.mjs",
    "build:publication": "node scripts/build-publication-model.mjs",
    "sync:elements": "node scripts/sync-elements-baseline.mjs",
    "build:studio": "npm run prepare:studio && npm --prefix studio run build",
    "prepare:studio": "npm run sync:elements && npm run build:book && npm run build:publication",
    "test:studio": "cd studio && npm run test",
    "check:studio": "cd studio && npm run build",
    "test": "node --test scripts/tests/*.test.mjs",
    "studio": "npm run prepare:studio && cd studio && npm run dev",
    "generate:records": "node scripts/generate-element-records.mjs",
    "setup": "npm ci && npm --prefix studio ci",
    "preview:studio": "npm --prefix studio run preview -- --host 127.0.0.1",
    "test:e2e": "npm --prefix studio run test:e2e"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.6.1"
  }
}
